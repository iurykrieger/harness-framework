{
  "cost": {
    "class": "medium",
    "compute": {
      "cpu": "medium",
      "memory_mb": 1024
    },
    "latency": {
      "p50_ms": 8000,
      "p95_ms": 45000,
      "timeout_ms": 300000
    }
  },
  "description": "On every pull request, runs the shared lib/ test suite with -race -count=1 -v so each test result becomes an individually-actionable Signal; regulates behaviour of schema, sensor, signal, subprocess, and template helpers. Output is stream — one Signal per --- PASS|FAIL|SKIP line plus a final aggregate. Auto-detected via /detect-sensors from .github/workflows/test.yml.",
  "determinism": "high",
  "execution": {
    "command": "go test -race -count=1 -v ./lib/...",
    "exit_code_map": [
      {
        "exit_code": 0,
        "severity": "info",
        "verdict": "pass"
      },
      {
        "exit_code": "*",
        "severity": "high",
        "verdict": "fail"
      }
    ],
    "output_parsing": {
      "patterns": [
        {
          "captures": {
            "excerpt": 1
          },
          "regex": "^\\s*--- PASS: (\\S+)",
          "severity": "info",
          "verdict": "pass"
        },
        {
          "captures": {
            "excerpt": 1
          },
          "regex": "^\\s*--- FAIL: (\\S+)",
          "severity": "high",
          "verdict": "fail"
        },
        {
          "captures": {
            "excerpt": 1
          },
          "regex": "^\\s*--- SKIP: (\\S+)",
          "severity": "low",
          "verdict": "warn"
        }
      ]
    }
  },
  "id": "unit-test-lib",
  "kind": "assertion",
  "name": "Unit tests (lib/)",
  "output": "stream",
  "phase": "pre-merge",
  "references": [
    "Auto-generated by /detect-sensors on 2026-05-08",
    ".github/workflows/test.yml step \"Test lib\""
  ],
  "regulation": "behaviour",
  "triggers": [
    {
      "on": "pull-request"
    }
  ],
  "type": "computational",
  "verification": {
    "golden_cases": [
      {
        "expected_severity": "info",
        "expected_verdict": "pass",
        "fixture": "sensors/fixtures/unit-test/all-pass.txt",
        "notes": "Captured stdout from a clean go test -v run (one test + one parent test with two subtests). Patterns match four PASS lines; aggregate worst-of-two with simulated exit 0 = pass."
      },
      {
        "expected_severity": "high",
        "expected_verdict": "fail",
        "fixture": "sensors/fixtures/unit-test/has-failure.txt",
        "notes": "One --- FAIL plus one --- PASS. Stream max = fail; aggregate = fail/high."
      },
      {
        "expected_severity": "low",
        "expected_verdict": "warn",
        "fixture": "sensors/fixtures/unit-test/has-skip.txt",
        "notes": "One --- SKIP plus one --- PASS. Stream max = warn; aggregate = warn/low."
      }
    ]
  },
  "version": "0.1.0"
}
