{
  "argv": [
    "write-sensor",
    "--out=/tmp/projectE/.harness/sensors",
    "/tmp/draft-lint.yaml"
  ],
  "draft_payload": {
    "cost": {
      "compute": "low",
      "latency": {
        "timeout_ms": 60000
      }
    },
    "description": "Run `go vet ./...` over the repo.",
    "execution": {
      "command": "go vet ./...",
      "exit_code_map": [
        {
          "exit_code": 0,
          "severity": "info",
          "verdict": "pass"
        },
        {
          "exit_code": 1,
          "severity": "high",
          "verdict": "fail"
        }
      ]
    },
    "id": "lint-go-vet-computational",
    "kind": "observation",
    "output": "single",
    "type": "computational",
    "version": "0.1.0"
  }
}
