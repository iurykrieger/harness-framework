{
  "cost": {
    "class": "medium",
    "compute": {
      "cpu": "medium",
      "memory_mb": 1024
    },
    "latency": {
      "p50_ms": 10000,
      "p95_ms": 60000,
      "timeout_ms": 300000
    }
  },
  "description": "On every pull request, runs the full skills/ test suite under the run_inferential build tag with -race -count=1 -v; regulates behaviour of the inferential sensor runner (template rendering, calibration downgrade, HARNESS_PROMPT plumbing). Output is stream. Auto-detected via /detect-sensors from .github/workflows/test.yml.",
  "determinism": "high",
  "execution": {
    "command": "go test -race -count=1 -v -tags=run_inferential ./skills/...",
    "exit_code_map": [
      {
        "exit_code": 0,
        "severity": "info",
        "verdict": "pass"
      },
      {
        "exit_code": "*",
        "severity": "high",
        "verdict": "fail"
      }
    ],
    "output_parsing": {
      "patterns": [
        {
          "captures": {
            "excerpt": 1
          },
          "regex": "^\\s*--- PASS: (\\S+)",
          "severity": "info",
          "verdict": "pass"
        },
        {
          "captures": {
            "excerpt": 1
          },
          "regex": "^\\s*--- FAIL: (\\S+)",
          "severity": "high",
          "verdict": "fail"
        },
        {
          "captures": {
            "excerpt": 1
          },
          "regex": "^\\s*--- SKIP: (\\S+)",
          "severity": "low",
          "verdict": "warn"
        }
      ]
    }
  },
  "id": "unit-test-skills-inferential",
  "name": "Unit tests (skills/, run_inferential)",
  "output": "stream",
  "phase": "pre-merge",
  "references": [
    "Auto-generated by /detect-sensors on 2026-05-08",
    ".github/workflows/test.yml step \"Test inferential runner\""
  ],
  "regulation": "behaviour",
  "triggers": [
    {
      "on": "pull-request"
    }
  ],
  "type": "computational",
  "verification": {
    "golden_cases": [
      {
        "expected_severity": "info",
        "expected_verdict": "pass",
        "fixture": "sensors/fixtures/unit-test/all-pass.txt",
        "notes": "Patterns produce four pass individuals from the captured go test -v stdout; aggregate = pass/info."
      },
      {
        "expected_severity": "high",
        "expected_verdict": "fail",
        "fixture": "sensors/fixtures/unit-test/has-failure.txt",
        "notes": "Stream contains one --- FAIL line; aggregate = fail/high."
      },
      {
        "expected_severity": "low",
        "expected_verdict": "warn",
        "fixture": "sensors/fixtures/unit-test/has-skip.txt",
        "notes": "Stream contains one --- SKIP line; aggregate = warn/low."
      }
    ]
  },
  "version": "0.1.0"
}
